# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# ---------- AI provider ----------
# "ollama": a local Ollama server (free, private: documents never leave your machine)
# "groq":   Groq's hosted API (used by the live site; Groq doesn't train on API data)
LLM_PROVIDER=ollama

# Ollama settings (when LLM_PROVIDER=ollama)
OLLAMA_API_BASE=http://localhost:11434
# Must be installed first: ollama pull <name>. Examples: llama2, llama3.1, mistral
OLLAMA_MODEL=llama2
# The model's context window in tokens. Longer text is refused with a clear message
# instead of being silently cut off. llama2: 4096. Newer models (e.g. llama3.1) handle much more.
OLLAMA_NUM_CTX=4096

# Groq settings (when LLM_PROVIDER=groq). Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# openai/gpt-oss-120b gave the most accurate answers in testing. Same free quota as the
# other Groq chat models: 1,000 requests/day and 8,000 tokens/minute (shared by all visitors).
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Rate limits (per visitor, on the AI tools) ----------
# Protects the AI provider's shared free quota. 0 turns a limit off.
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=50
# Set to true only behind a trusted proxy (e.g. Render), so the visitor's IP is read
# from the proxy's headers instead of the proxy's own address.
TRUST_PROXY_HEADERS=false

# ---------- Input limits ----------
# Max characters of text per request (pasted text, or text extracted from a PDF).
# Leave unset for the default: 20000 with Groq (its free plan's 8,000 tokens/minute), 50000 with Ollama.
# MAX_TEXT_CHARS=20000
# Max PDF upload size in megabytes
MAX_PDF_MB=10

# ---------- Other ----------
# Other websites allowed to call this API from a browser (CORS).
# Leave empty: the app's own pages don't need it. Only set this if you host a
# separate frontend, e.g. ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# "*" allows any site but then never sends cookies/credentials.
ALLOWED_ORIGINS=

# Port for `python main.py` (Render sets this automatically)
PORT=8000
