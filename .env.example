# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# Where the Ollama server is running
OLLAMA_API_BASE=http://localhost:11434

# Model to use. Must be installed first: ollama pull <name>
# Examples: llama2, llama3, llama3.1, mistral
OLLAMA_MODEL=llama2

# Other websites allowed to call this API from a browser (CORS).
# Leave empty: the app's own pages don't need it. Only set this if you host a
# separate frontend, e.g. ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# "*" allows any site but then never sends cookies/credentials.
ALLOWED_ORIGINS=

# Port for `python main.py` (Render sets this automatically)
PORT=8000

# Input limits
# Max characters of text per request (pasted text, or text extracted from a PDF)
MAX_TEXT_CHARS=50000
# Max PDF upload size in megabytes
MAX_PDF_MB=10
