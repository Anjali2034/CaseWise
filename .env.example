# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# Where the Ollama server is running
OLLAMA_API_BASE=http://localhost:11434

# Model to use. Must be installed first: ollama pull <name>
# Examples: llama2, llama3, llama3.1, mistral
OLLAMA_MODEL=llama2

# Comma-separated list of origins allowed to call the API from a browser
ALLOWED_ORIGINS=*

# Port for `python main.py` (Render sets this automatically)
PORT=8000
